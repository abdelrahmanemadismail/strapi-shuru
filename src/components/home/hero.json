    "badgeText": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "subtitle": {
      "type": "text"
    },
    "primaryCtaText": {
      "type": "string"
    },
    "primaryCtaLink": {
      "type": "string"
    },
    "secondaryCtaText": {
      "type": "string"
    },
    "secondaryCtaLink": {
      "type": "string"
    },
    "targetAudiences": {
      "type": "component",
      "repeatable": true,
      "component": "home.audience-badge"
    },
    "showShowcase": {
      "type": "boolean",
      "default": true
    },
    "showcaseTitle": {
      "type": "string"
    },
    "showcaseSubtitle": {
      "type": "string"
    },
    "showcaseBadge": {
      "type": "string"
    },
    "metrics": {
      "type": "component",
      "repeatable": true,
      "component": "home.metric-item"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"]
    }
  }
