{
  "kind": "collectionType",
  "collectionName": "contact_submissions",
  "info": {
    "singularName": "contact-submission",
    "pluralName": "contact-submissions",
    "displayName": "Contact Submissions",
    "description": "Form submissions from the Contact Us / Diagnostic Session page"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "company": {
      "type": "string",
      "required": true
    },
    "entityType": {
      "type": "string",
      "required": true
    },
    "desiredService": {
      "type": "string",
      "required": true
    },
    "challenge": {
      "type": "string",
      "required": true
    },
    "preferredDate": {
      "type": "string"
    },
    "message": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "new",
        "in_review",
        "contacted",
        "completed",
        "archived"
      ],
      "default": "new"
    }
  }
}
